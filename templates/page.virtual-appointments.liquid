    /** NEW 7/18/23: calling methods automatically on page load based on URL param
     * URL params are the following:
     * - url_key => 'special-order', 'after-purchase-consultation', etc  (MUST BE VALID)
     * - cta_id => 'cta-1', 'cta-2', etc
     */
    window.onload = function() {
        var urlParams = new URLSearchParams(window.location.search),
            urlKey = urlParams.get('url_key'),
            ctaId = urlParams.get('cta_id');

        if (urlKey) {
            var url = 'https://calendly.com/tadashishoji/'+urlKey;
            Calendly.showPopupWidget(
                url
            );
        } else if (ctaId) {
            document.getElementById(ctaId).click();
        }

    };

