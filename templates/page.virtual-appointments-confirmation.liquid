<script>

    const urlParams = new URLSearchParams(window.location.search);

    var eventName = urlParams.get('event_type_name'),
        eventStartTime = decodeURIComponent(urlParams.get('event_start_time')),
        eventEndTime = decodeURIComponent(urlParams.get('event_end_time')),
        inviteeFullName = urlParams.get('invitee_full_name'),
        inviteeEmail = urlParams.get('invitee_email');

    var _timeInfo = '',
        _dayInfo = '';

    if (eventStartTime) {
        
        _timeInfo += new Date(eventStartTime).toLocaleTimeString(undefined, {timeStyle: 'short'}).toLowerCase().replace(/\s/g, '');
        
        _dayInfo += new Intl.DateTimeFormat('en-US', {weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'}).format(new Date(eventStartTime));
    
    }
    if (eventEndTime) {
        
        _timeInfo += ' - ';

        _timeInfo += new Date(eventEndTime).toLocaleTimeString(undefined, {timeStyle: 'short'}).toLowerCase().replace(/\s/g, '');
        
        if (_dayInfo == '') {
            _dayInfo = new Intl.DateTimeFormat('en-US', {weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'}).format(new Date(eventEndTime));
        }

    }

    var eventTimeString = _timeInfo && _dayInfo ? _timeInfo + '<br>' + _dayInfo : _timeInfo + _dayInfo;

    document.getElementById('eventName').innerHTML = eventName;
    document.getElementById('eventTime').innerHTML = eventTimeString;

</script>
